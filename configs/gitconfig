[core]
	editor = nvim
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

# Per-machine identity (user.name / user.email) and any work-only rules live here.
# Generated by apply-configs.sh, never tracked in this repo. Must stay last so it wins.
[include]
	path = ~/.gitconfig.local
