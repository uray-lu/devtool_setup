# ---------- Oh My Zsh ----------
export ZSH="$HOME/.oh-my-zsh"
# Theme is disabled — Starship handles the prompt below
ZSH_THEME=""

# zsh-completions needs its fpath set before compinit (which omz runs)
fpath+=("$ZSH/custom/plugins/zsh-completions/src")

# zsh-syntax-highlighting must be LAST in this list
plugins=(
  git
  z
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# ---------- User config ----------
export EDITOR=nvim
export VISUAL=nvim

export PATH="$HOME/bin:$HOME/go/bin:$HOME/.local/bin:/opt/homebrew/bin:$PATH"

export GOPRIVATE='github.com/trend-ctcs/*'

# Land in workspace on new shells (skip when sub-shells / scripts)
[[ -o interactive && -z "$IN_NESTED_SHELL" ]] && cd ~/Workspace

# ---------- Welcome banner (only on interactive shells) ----------
# Runs fastfetch + one-line weather on terminal open. Skipped in scripts,
# SSH-non-interactive, tmux/vim subshells, and Claude Code's shell wrapper.
# --max-time 2 keeps the shell from hanging if wttr.in is slow/down.
if [[ -o interactive && -z "$IN_NESTED_SHELL" && -z "$TMUX" && -z "$VIM" ]]; then
  fastfetch
fi

# ---------- Starship prompt ----------
eval "$(starship init zsh)"
